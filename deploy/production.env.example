# Agent Guard — production compose configuration.
# Copy to deploy/production.env and set a strong key. NEVER commit the real file.
#
#   cp deploy/production.env.example deploy/production.env
#
# The same AGENTGUARD_API_KEY is used by the backend (to authenticate requests)
# and by the nginx proxy (to inject the header server-side). It is never exposed
# to the browser.

# REQUIRED — a strong random shared key (e.g. `openssl rand -hex 24`).
AGENTGUARD_API_KEY=change-me-to-a-strong-random-key

# OPTIONAL — enables the Claude relevance advisor. Leave blank to use the offline
# heuristic advisor (goal-awareness still works).
ANTHROPIC_API_KEY=

# Advisor selection: auto | llm | heuristic | off
AGENTGUARD_ADVISOR=auto
AGENTGUARD_ADVISOR_MODEL=claude-opus-5

# Hardening.
AGENTGUARD_RATE_LIMIT_PER_MINUTE=120
AGENTGUARD_MAX_REQUEST_BYTES=2000000
AGENTGUARD_CORS_ORIGINS=
AGENTGUARD_LOG_LEVEL=INFO
