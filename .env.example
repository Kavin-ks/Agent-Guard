# Agent Guard — example environment. Copy to backend/.env and fill in.
# NEVER commit the real .env (it is gitignored).

# --- API auth (prototype: static key on all non-health routes) ---
AGENTGUARD_API_KEY=change-me-in-production

# --- LLM goal reasoning (Phase 3). Required for the live goal-compiler path. ---
# The engine and test suite do NOT require this; deterministic gates work offline.
ANTHROPIC_API_KEY=

# --- Goal-relevance advisor (Phase 3) ---
AGENTGUARD_ADVISOR=auto              # auto | llm | heuristic | off
AGENTGUARD_ADVISOR_MODEL=claude-opus-5

# --- Persistence (Phase 5). SQLite by default; the audit trail survives restarts. ---
AGENTGUARD_DB_PATH=./data/agentguard.db
AGENTGUARD_APPROVAL_TTL_SECONDS=3600
