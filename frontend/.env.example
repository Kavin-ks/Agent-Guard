# Frontend dev-server configuration.
# The API key is NEVER embedded in the browser bundle. In dev, the Vite proxy
# (vite.config.ts) injects X-API-Key server-side from AGENTGUARD_API_KEY.

# Backend base URL the dev proxy forwards "/api/*" to:
VITE_BACKEND_URL=http://127.0.0.1:8000

# API key used ONLY by the dev-server proxy (Node side), not shipped to the browser:
AGENTGUARD_API_KEY=change-me-to-match-backend

# Optional: override the in-browser API base (defaults to same-origin "/api").
# VITE_API_BASE_URL=/api
